{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://leash-server-production.up.railway.app/v1/:path*" },
    { "source": "/shop/:path*", "destination": "https://leash-server-production.up.railway.app/shop/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
