{
  "name": "leash",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "start": "tsx apps/server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "merchant": "tsx apps/merchant/src/index.ts",
    "legacy": "tsx apps/legacy-sim/src/index.ts",
    "setup:hedera": "tsx scripts/setup-hedera.ts",
    "dev:fake": "LEASH_FAKE_CHAINS=1 tsx watch apps/server/src/index.ts",
    "agent": "tsx apps/agent/src/index.ts",
    "rehearse": "tsx scripts/demo-rehearsal.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
