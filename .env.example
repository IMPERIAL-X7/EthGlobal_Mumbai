# Copy to .env. docs/KEYS.md explains every value and where to get it.
# Never commit .env.

# See docs/KEYS.md for what each value is and where to get it.

# --- World ID (developer.world.org) ---
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ENV=staging
# Fallback only (auth.world.org/portal)
WORLD_OIDC_CLIENT_ID=
WORLD_OIDC_CLIENT_SECRET=
WORLD_OIDC_REDIRECT_URI=

# --- Hedera testnet (portal.hedera.com) ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
LEASH_SERVER_COSIGN_KEY=   # generated by npm run setup:hedera
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
HEDERA_USDC_TOKEN_ID=0.0.429274
HCS_AUDIT_TOPIC_ID=   # generated by npm run setup:hedera
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# --- Demo merchant ---
MERCHANT_ACCOUNT_ID=   # generated by npm run setup:hedera
MERCHANT_PRIVATE_KEY=   # generated by npm run setup:hedera
ATTACKER_ACCOUNT_ID=   # generated by npm run setup:hedera

# --- Demo agent ---
LEASH_API_URL=http://localhost:4000/v1
LEASH_AGENT_API_KEY=   # from the agent's keys screen
AGENT_ACCOUNT_KEY=   # from the agent's keys screen
AGENT_HOT_ACCOUNT_ID=   # from the agent's keys screen
AGENT_VAULT_ACCOUNT_ID=   # from the agent's keys screen
# Agent model backend (apps/agent/src/providers.ts):
#   cli:sonnet / cli:haiku / cli:opus  -> your Claude Code login (Pro/Max plan), no key needed
#   claude-opus-5-5 ...                -> ANTHROPIC_API_KEY (paid per token)
#   github:openai/gpt-4.1-mini, groq:qwen/qwen3-32b, gemini:gemini-2.5-flash, openrouter:<m>:free -> free tiers
AGENT_MODEL=cli:sonnet
ANTHROPIC_API_KEY=
GITHUB_MODELS_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- ENSv2 (Sepolia) ---
SEPOLIA_RPC_URL=
ENS_OPERATOR_PRIVATE_KEY=
ENS_PARENT_NAME=leash.eth
ENS_CHAIN_ID=11155111

# --- Server ---
PORT=4000
PUBLIC_BASE_URL=http://localhost:5180
WEB_ORIGIN=http://localhost:5180
DATABASE_URL=file:./leash.db
SESSION_SECRET=   # openssl rand -hex 32
LEASH_FAKE_CHAINS=0

# --- Optional ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENS_RESOLVER=   # generated by scripts/setup-ens.ts
