# See docs/KEYS.md for what each value is and where to get it.

# --- World ID (developer.world.org) ---
WORLD_APP_ID=app_xxxxxxxx
WORLD_RP_ID=rp_xxxxxxxx
WORLD_SIGNING_KEY=
WORLD_ENV=staging
# Fallback only (auth.world.org/portal)
WORLD_OIDC_CLIENT_ID=
WORLD_OIDC_CLIENT_SECRET=
WORLD_OIDC_REDIRECT_URI=

# --- Hedera testnet (portal.hedera.com) ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.
HEDERA_OPERATOR_KEY=
LEASH_SERVER_COSIGN_KEY=          # generated by `pnpm setup`
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
HEDERA_USDC_TOKEN_ID=0.0.429274
HCS_AUDIT_TOPIC_ID=               # generated by `pnpm setup`
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# --- Demo merchant ---
MERCHANT_ACCOUNT_ID=0.0.
MERCHANT_PRIVATE_KEY=
ATTACKER_ACCOUNT_ID=              # generated by `pnpm setup`

# --- Demo agent ---
LEASH_API_URL=http://localhost:4000/v1
LEASH_AGENT_API_KEY=              # issued on agent creation
AGENT_ACCOUNT_KEY=                # generated; lives only with the agent
AGENT_HOT_ACCOUNT_ID=
AGENT_VAULT_ACCOUNT_ID=
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# --- ENSv2 (Sepolia) ---
SEPOLIA_RPC_URL=
ENS_OPERATOR_PRIVATE_KEY=
ENS_PARENT_NAME=leash.eth
ENS_CHAIN_ID=11155111

# --- Server ---
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=file:./leash.db
SESSION_SECRET=
LEASH_FAKE_CHAINS=0

# --- Optional ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
